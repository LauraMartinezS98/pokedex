extends layout/index

block contenido
    //- Configuración local de traducciones para la interfaz
    -
        const traducciones = {
            normal: 'Normal', fighting: 'Lucha', flying: 'Volador', poison: 'Veneno', ground: 'Tierra',
            rock: 'Roca', bug: 'Bicho', ghost: 'Fantasma', steel: 'Acero', fire: 'Fuego', water: 'Agua',
            grass: 'Planta', electric: 'Eléctrico', psychic: 'Psíquico', ice: 'Hielo', dragon: 'Dragón',
            dark: 'Siniestro', fairy: 'Hada', unknown: 'Desconocido', shadow: 'Sombra', 'Ninguno': 'Ninguno'
        }

    main.container.mt-5
        .row.justify-content-center
            .col-md-10
                .card.shadow-lg.border-0(style="border-radius: 20px; overflow: hidden;")
                    //- Header estilo Nintendo Switch
                    .card-header.text-white.text-center.py-4(style="background-color: #E60012;")
                        h2.mb-0 Perfil de Entrenador

                    .card-body.p-5
                        //- Identificación del Entrenador
                        .text-center.mb-4
                            img.img-fluid.rounded-circle.mb-3(src="https://upload.wikimedia.org/wikipedia/commons/5/53/Pok%C3%A9_Ball_icon.svg" width="80" alt="Avatar")
                            h3.font-weight-bold ¡Hola, #{usuario ? usuario.nombre : 'Entrenador'}!
                            p.text-muted Panel de gestión táctica del equipo

                        //- Dashboard de Análisis Estadístico
                        if analisis
                            .card.bg-light.border-0.p-4.mb-5(style="border-radius: 15px;")
                                h5.text-center.mb-4.text-uppercase.font-weight-bold(style="color: #666; font-size: 0.8rem; letter-spacing: 2px;") Estadísticas Globales del Equipo

                                //- Progreso de Captura
                                .mb-4
                                    .d-flex.justify-content-between.mb-1
                                        label.small.font-weight-bold.mb-0 Capacidad del Equipo
                                        span.small.font-weight-bold #{analisis.total} / 6
                                    .progress(style="height: 8px; border-radius: 10px;")
                                        - var porcentaje = (analisis.total / 6) * 100
                                        .progress-bar.bg-danger(role="progressbar" style=`width: ${porcentaje}%`)

                                //- Métricas Comparativas
                                .row.text-center
                                    .col-md-4
                                        h6.text-muted.small.text-uppercase Tipo Dominante
                                        span.badge.badge-dark.px-3.py-2.text-uppercase #{traducciones[analisis.tipoDominante] || analisis.tipoDominante}
                                    .col-md-4
                                        h6.text-muted.small.text-uppercase Peso Promedio
                                        p.font-weight-bold.mb-0 #{analisis.promedioPeso} kg
                                    .col-md-4
                                        h6.text-muted.small.text-uppercase Altura Promedio
                                        p.font-weight-bold.mb-0 #{analisis.promedioAltura} m

                        hr.my-5

                        //- Gestión de Miembros del Equipo
                        h3.text-center.mb-4.font-weight-bold(style="color: #E60012;") Mi Equipo Actual

                        .row.justify-content-center
                            each slot, index in equipo
                                .col-6.col-md-4.col-lg-2.mb-4
                                    if slot
                                        //- Ranura Ocupada
                                        .card.h-100.shadow-sm.text-center.border-danger.position-relative(style="border-radius: 15px;")
                                            //- Acción: Liberar Pokémon
                                            form(action=`/pokemons/soltar/${slot.id}` method="POST" style="position: absolute; top: 5px; right: 5px; z-index: 10;")
                                                button.btn.btn-danger.rounded-circle.shadow-sm.p-0(type="submit" style="width: 24px; height: 24px; font-size: 10px; border: 2px solid #fff;") ✕

                                            a.text-decoration-none.color-inherit.p-2(href=`/pokemons/${slot.id}`)
                                                img.card-img-top.p-1(src=slot.imagen alt=slot.nombre style="object-fit: contain; max-height: 80px;")
                                                .card-body.p-1
                                                    small.font-weight-bold.text-capitalize.d-block.mb-2= slot.nombre

                                                    //- Mini-Gráficos de Atributos
                                                    if slot.stats
                                                        .stats-container.text-left(style="font-size: 0.6rem;")
                                                            //- Mapeo rápido de HP, ATK y SPD
                                                            each statIndex, i in [0, 1, 5]
                                                                - const label = ['HP', 'ATK', 'SPD'][i]
                                                                - const color = ['bg-success', 'bg-danger', 'bg-info'][i]
                                                                .d-flex.justify-content-between
                                                                    span.text-muted= label
                                                                    span.font-weight-bold= slot.stats[statIndex].base_stat
                                                                .progress.mb-1(style="height: 3px;")
                                                                    .progress-bar(class=color style=`width: ${Math.min(slot.stats[statIndex].base_stat, 150) / 1.5}%`)
                                    else
                                        //- Ranura Disponible
                                        .card.h-100.text-center.bg-light(style="border: 2px dashed #ddd; min-height: 160px; border-radius: 15px;")
                                            a.d-flex.flex-column.align-items-center.justify-content-center.w-100.h-100.text-decoration-none.text-muted(href="/pokemons")
                                                span.h2.mb-0 +
                                                small Añadir

                        .text-center.mt-5
                            a.btn.btn-outline-danger.rounded-pill.px-4(href="/pokemons") Volver a la Pokédex