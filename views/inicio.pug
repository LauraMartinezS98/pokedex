extends ./layout/index

block contenido
    //- SECCIÓN HERO (Encabezado)
    .jumbotron.text-white.text-center(style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/img/pokemon-inicio.jpg'); background-size: cover; padding: 80px 0; border-radius: 0; margin-bottom: 0;")
        .container
            h1.display-4.font-weight-bold Gestión Pokémon Avanzada
            p.lead Analiza estadísticas, construye tu equipo y domina la liga.
            a.btn.btn-danger.btn-lg.rounded-pill.mt-3(href="/pokemons" style="background-color: #E60012; border: none;") Ver Pokédex Completa

    main.container.py-5
        //- SECCIÓN: CARACTERÍSTICAS
        .row.text-center
            .col-md-4
                .p-4
                    img.mb-3(src="https://upload.wikimedia.org/wikipedia/commons/5/53/Pok%C3%A9_Ball_icon.svg" width="60")
                    h4.font-weight-bold Captura
                    p.text-muted Registra tus Pokémon favoritos y añádelos a tu equipo personal.
            .col-md-4
                .p-4
                    svg.mb-3(xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#E60012" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        line(x1="18" y1="20" x2="18" y2="10")
                        line(x1="12" y1="20" x2="12" y2="4")
                        line(x1="6" y1="20" x2="6" y2="14")
                    h4.font-weight-bold Analiza
                    p.text-muted Revisa pesos, alturas y estadísticas base para crear estrategias.
            .col-md-4
                .p-4
                    svg.mb-3(xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#E60012" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
                        circle(cx="9" cy="7" r="4")
                        path(d="M23 21v-2a4 4 0 0 0-3-3.87")
                        path(d="M16 3.13a4 4 0 0 1 0 7.75")
                    h4.font-weight-bold Comparte
                    p.text-muted Deja tus comentarios y lee las opiniones de otros entrenadores.

    //- SECCIÓN COMENTARIOS
    include ./layout/layout_comentario