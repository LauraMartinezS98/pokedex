extends ./layout/index
include layout_pokemon

block contenido
    main.container.mt-5
        h1.text-center.mb-5.font-weight-bold(style="color: #E60012;") #{pagina}

        if mensajes && mensajes.error
            .row.justify-content-center
                .col-md-8
                    each alerta in mensajes.error
                        .alert.alert-danger.text-center.py-3.mb-4(role="alert")
                            | #{alerta}

        //- Dentro de pokemons.pug
        .row.proximos-pokemons
            each pokemon in pokemons
                include ./layout/layout_pokemons