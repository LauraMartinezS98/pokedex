extends ./layout/index

block contenido
    main.container.mt-5
        //- Título de la sección (Pokédex Nacional)
        h1.text-center.mb-5.font-weight-bold(style="color: #E60012;") #{pagina}

        //- Bloque de Alertas
        if mensajes && mensajes.error
            .row.justify-content-center
                .col-md-8
                    each alerta in mensajes.error
                        .alert.alert-danger.text-center.py-3.mb-4(
                            role="alert"
                            style="border-radius: 15px; border: none; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.05);"
                        )
                            i.fas.fa-exclamation-triangle.mr-2
                            | #{alerta}

        //- Rejilla de Pokémon
        include layouts/layout_pokemon
