extends layout/index

block contenido
    main.container.mt-5
        //- SECCIÓN: QUIÉNES SOMOS
        .row.align-items-center
            .col-md-5
                img(src="/img/pokemon.jpg", alt="Entrenadores Pokémon", class="img-fluid mb-4 rounded-xl shadow-lg" style="border-radius: 20px;")

            .col-md-7
                h1.mb-3.font-weight-bold #{pagina}

                blockquote.blockquote.text-muted.mb-4(style="border-left: 5px solid #E60012; padding-left: 15px; font-style: italic;")
                    | "La victoria no depende solo de la fuerza, sino de conocer a tu equipo."

                p Hemos desarrollado el laboratorio definitivo para entrenadores que buscan optimizar su rendimiento y dominar la Liga Pokémon mediante el análisis de datos.

                //- Ventajas competitivas de la plataforma
                ul.list-unstyled.mt-4
                    li.mb-3.d-flex.align-items-center
                        i.fas.fa-check-circle.text-danger.mr-3
                        span <strong>Tu Dream Team:</strong> Gestión avanzada de tu equipo de 6 integrantes.
                    li.mb-3.d-flex.align-items-center
                        i.fas.fa-check-circle.text-danger.mr-3
                        span <strong>Datos Reales:</strong> Acceso directo a la PokéAPI con estadísticas precisas.
                    li.mb-3.d-flex.align-items-center
                        i.fas.fa-check-circle.text-danger.mr-3
                        span <strong>Estrategia Pura:</strong> Análisis de sinergias y tipos dominantes.

    //- SECCIÓN: CARACTERÍSTICAS TÉCNICAS
    .listado-iconos.bg-light.mt-5.py-5
        .container.text-center
            .row
                //- Característica 1: Team Builder
                .col-md-4.mb-4
                    svg.mb-4(xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewbox='0 0 24 24' stroke-width='1.5' stroke='#E60012' fill='none' stroke-linecap='round' stroke-linejoin='round')
                        circle(cx='12' cy='12' r='9')
                        circle(cx='12' cy='12' r='3')
                        line(x1='3' y1='12' x2='9' y2='12')
                        line(x1='15' y1='12' x2='21' y2='12')
                    h2.mb-3 Team Builder
                    p Selecciona tus 6 Pokémon favoritos, balancea sus tipos y crea el escuadrón definitivo para la competición.

                //- Característica 2: Datos
                .col-md-4.mb-4
                    svg.mb-4(xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewbox='0 0 24 24' stroke-width='1.5' stroke='#E60012' fill='none' stroke-linecap='round' stroke-linejoin='round')
                        circle(cx='10' cy='10' r='7')
                        line(x1='21' y1='21' x2='15' y2='15')
                        path(d='M10 10a3 5 0 0 1 3 -2')
                    h2.mb-3 Datos Precisos
                    p Consulta la Pokédex Nacional en tiempo real. Información detallada sobre tipos, pesos y alturas base.

                //- Característica 3: Estrategia
                .col-md-4.mb-4
                    svg.mb-4(xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewbox='0 0 24 24' stroke-width='1.5' stroke='#E60012' fill='none' stroke-linecap='round' stroke-linejoin='round')
                        line(x1='8' y1='21' x2='16' y2='21')
                        line(x1='12' y1='17' x2='12' y2='21')
                        line(x1='7' y1='4' x2='17' y2='4')
                        path(d='M17 4v8a5 5 0 0 1 -10 0v-8')
                    h2.mb-3 Rumbo a la Cima
                    p Planifica tus enfrentamientos conociendo tus debilidades y fortalezas antes de entrar al gimnasio.