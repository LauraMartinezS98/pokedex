header
    .navegacion(style="background-color: #E60012;")
        .container
            .row.align-items-center.py-3
                //- 1. COLUMNA IZQUIERDA: LOGO
                .col-md-3.col-6
                    a(href="/")
                        img.img-fluid(src="/img/pokedex-logo.png", alt="Logo Pokemon")

                //- 2. COLUMNA CENTRAL: MENÚ DE NAVEGACIÓN
                .col-md-5.col-12.mt-3.mt-md-0.text-center
                    nav.nav.justify-content-center
                        a.nav-link(href="/nosotros" style="color: white; font-weight: 500;") Nosotros
                        a.nav-link(href="/pokemons" style="color: white; font-weight: 500;") Pokémons
                        a.nav-link(href="/comentarios" style="color: white; font-weight: 500;") Comentarios

                //- 3. COLUMNA DERECHA: BOTONES Y BUSCADOR
                .col-md-4.col-12.d-flex.flex-column.align-items-center.align-items-md-end.justify-content-center.mt-3.mt-md-0

                    //- A) BLOQUE DE BOTONES (Arriba)
                    .botones-usuario.mb-2.d-flex.justify-content-end
                        - var estiloBoton = "background-color: white; border: 2px solid white; color: black; font-weight: bold;"

                        if usuario
                            //- === USUARIO LOGUEADO ===
                            div.d-flex.align-items-center
                                a.d-none.d-lg-flex.align-items-center.px-3.py-1.mr-2.rounded-pill(
                                    href="/auth/perfil"
                                    style="background-color: white; border: 1px solid rgba(255, 255, 255, 0.4); text-decoration: none; color: black; font-size: 0.9rem;"
                                )
                                    svg.mr-2(xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewbox='0 0 24 24' stroke-width='2' stroke='black' fill='none' stroke-linecap='round' stroke-linejoin='round')
                                        path(stroke='none' d='M0 0h24v24H0z' fill='none')
                                        circle(cx='12' cy='7' r='4')
                                        path(d='M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2')
                                    span.font-weight-bold #{usuario.nombre}

                                //- Botón Salir
                                form(action="/auth/cerrar-sesion" method="POST" style="margin: 0;")
                                    button.btn.btn-sm.rounded-pill.px-3.d-flex.align-items-center.shadow-sm(
                                        type="submit"
                                        style="background-color: white; border: 2px solid white; color: #E60012; font-weight: 800;"
                                    ) Salir

                        else
                            //- === SIN LOGUEAR ===
                            div.d-flex
                                a.btn.btn-sm.rounded-pill.px-3.ml-2(href="/auth/login" style=estiloBoton) Ingresar
                                a.btn.btn-sm.rounded-pill.px-3.ml-2(href="/auth/registro" style=estiloBoton) ¡Únete!

                    //- B) FORMULARIO DE BÚSQUEDA (Abajo)
                    form.form-inline.justify-content-center.justify-content-md-end(action="/buscador" method="POST" style="width: 100%;")
                        .input-group.input-group-sm(style="max-width: 250px;")
                            input.form-control(
                                type="search"
                                name="termino"
                                placeholder="Buscar Pokémon..."
                                style="border-top-left-radius: 20px; border-bottom-left-radius: 20px; border: none;"
                            )
                            .input-group-append
                                button.btn.btn-light.d-flex.align-items-center.justify-content-center(
                                    type="submit"
                                    style="border-top-right-radius: 20px; border-bottom-right-radius: 20px; border: none; height: 100%;"
                                )
                                    svg(xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 96 960 960" width="20" fill="#E60012")
                                        path(d="M784 936 532 684q-30 24-69 38t-83 14q-109 0-184.5-75.5T120 476q0-109 75.5-184.5T380 216q109 0 184.5 75.5T640 476q0 44-14 83t-38 69l252 252-56 56ZM380 656q75 0 127.5-52.5T560 476q0-75-52.5-127.5T380 296q-75 0-127.5 52.5T200 476q0 75 52.5 127.5T380 656Z")